<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.FamilyShare" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- 沉浸式状态栏：透明，地图延伸至顶部，无蓝边 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- 底部导航栏与面板同色（浅色） -->
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- 圆角风格统一：对话框圆角 + Material 对话框主题 -->
        <item name="android:dialogCornerRadius">20dp</item>
        <item name="materialAlertDialogTheme">@style/FamilyShare.Dialog</item>
    </style>

    <!-- 对话框：与主面板一致的圆角 -->
    <style name="FamilyShare.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/FamilyShare.Dialog.Shape</item>
    </style>

    <style name="FamilyShare.Dialog.Shape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <!-- 弹出菜单（右上角 ⋮）：圆角白底 -->
    <style name="FamilyShare.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_rounded</item>
        <item name="android:popupElevation">8dp</item>
    </style>
</resources>
